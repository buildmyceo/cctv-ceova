{
  "name": "ceova-cctv",
  "version": "1.0.0",
  "description": "CEOVA CCTV Autonomous Surveillance Hub for MacBook & Windows",
  "main": "electron/main.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "app": "electron electron/main.js",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:all": "electron-builder -mw"
  },
  "keywords": [
    "cctv",
    "webrtc",
    "camera-stream",
    "surveillance",
    "electron-app",
    "macbook",
    "windows"
  ],
  "author": "Ceova",
  "license": "MIT",
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "dotenv": "^18.0.8",
    "express": "^4.21.2",
    "jpeg-js": "^0.4.4",
    "pdfkit": "^0.20.2",
    "pngjs": "^7.0.0",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "selfsigned": "^2.4.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.ceova.cctv",
    "productName": "CEOVA-CCTV",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "mac": {
      "category": "public.app-category.video",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "CEOVA CCTV"
    },
    "files": [
      "server.js",
      "supabaseClient.js",
      "electron/**/*",
      "api/**/*",
      "bots/**/*",
      "context/**/*",
      "db/**/*",
      "events/**/*",
      "hardware/**/*",
      "identity/**/*",
      "public/**/*",
      "security/**/*",
      "services/**/*",
      "vision/**/*",
      "yolov8n.pt",
      "package.json",
      "!**/*.map",
      "!data/run/**/*",
      "!data/logs/**/*",
      "!data/*.db*",
      "!**/*.test.js",
      "!tests/**/*",
      "!releases/**/*",
      "!dist/**/*"
    ]
  }
}
